{
  "name": "lamatic-flow-qa",
  "version": "1.0.0",
  "description": "React Flow builder + Playwright quality suite (Lamatic.ai assessment)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "playwright test",
